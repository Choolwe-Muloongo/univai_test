APP_NAME=UnivAI
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://your-domain.com
FRONTEND_URL=https://app.your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=univai
DB_USERNAME=univai_owner
DB_PASSWORD=strong_password
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
# For higher concurrency, add managed Redis and switch CACHE_STORE/QUEUE_CONNECTION to redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# AI is routed through ApiFree only. Direct Gemini is intentionally disabled in AiController.
AI_PROVIDER=apifree
AI_API_KEY=YOUR_API_KEY
AI_BASE_URL=https://api.apifree.ai
AI_MODEL=google/gemini-2.5-flash-lite
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=1024
AI_MAX_PROMPT=4000
AI_MAX_CONTEXT=8000

DEFAULT_TUITION_FEE=650

UNIVAI_BRAND_NAME=UnivAI
UNIVAI_LEGAL_NAME="UnivAI University"
UNIVAI_TAGLINE="AI-powered higher education for every learner"
UNIVAI_SUPPORT_EMAIL=support@univai.edu
UNIVAI_ADMISSIONS_EMAIL=admissions@univai.edu
UNIVAI_TARGET_REGISTERED_USERS=10000
UNIVAI_TARGET_CONCURRENT_USERS=1000

UNIVAI_VERSION_LABEL=v1
UNIVAI_LAUNCH_PROFILE=university-plus-short-courses
UNIVAI_RELEASE_STATE=launch-ready
UNIVAI_DEMO_INCIDENTS=false